<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:pda="clr-namespace:Content.Client.PDA"
            Title="{Loc 'ghost-roles-window-title'}"
            MinSize="490 400"
            SetSize="490 500">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <!-- Navigation buttons -->
        <BoxContainer Name="NavigationBar"
                     HorizontalExpand="True"
                     MinHeight="32"
                     Margin="1 1 3 0"
                     Orientation="Horizontal">
            <pda:PdaNavigationButton Name="MainTabButton"
                                    Access="Public"
                                    MinWidth="100"
                                    LabelText="Главная"
                                    IsCurrent="True"
                                    HorizontalExpand="True"
                                    SizeFlagsStretchRatio="1"/>
            <pda:PdaNavigationButton Name="EventsTabButton"
                                    Access="Public"
                                    MinWidth="100"
                                    LabelText="Ивенты"
                                    HorizontalExpand="True"
                                    SizeFlagsStretchRatio="1"/>
        </BoxContainer>

        <!-- Content container -->
        <BoxContainer Name="ContentSwitcherContainer"
                     Orientation="Vertical"
                     VerticalExpand="True"
                     HorizontalExpand="True">
            <!-- Main view (roles) -->
            <BoxContainer Name="MainView"
                         Orientation="Vertical"
                         VerticalExpand="True"
                         HorizontalExpand="True">
                <Label Name="NoRolesMessage"
                       Text="{Loc 'ghost-roles-window-no-roles-available-label'}"
                       VerticalAlignment="Top" />
                <ScrollContainer VerticalExpand="True"
                                 HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical"
                                  Name="EntryContainer"
                                  VerticalExpand="True">
                        <!-- Ghost role entries are added here by code -->
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>

            <!-- Events view -->
            <BoxContainer Name="EventsView"
                         Orientation="Vertical"
                         VerticalExpand="True"
                         HorizontalExpand="True"
                         Visible="False">
                <ScrollContainer VerticalExpand="True"
                                 HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical"
                                  Name="EventsContainer"
                                  VerticalExpand="True">
                        <!-- Event entries are added here by code -->
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>

